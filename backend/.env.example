# Postgres connection string (psycopg v3 driver). REQUIRED - there is no default;
# the app refuses to start without it rather than falling back to localhost.
# For local dev with the provided docker-compose.yml, this matches out of the box.
DATABASE_URL=postgresql+psycopg://trade_journal:trade_journal@localhost:5432/trade_journal

# Secret used to sign JWTs. Generate a strong random value for real use, e.g.:
#   openssl rand -hex 32
JWT_SECRET=change-me

# Google OAuth Client ID (from Google Cloud Console -> APIs & Services -> Credentials).
# Used as the expected "audience" when verifying Google ID tokens on POST /auth/google.
# See the "Google OAuth setup" section in README.md for how to create one.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Auth cookie ---
# The JWT is delivered as an httpOnly cookie. Set COOKIE_SECURE=true in production
# (HTTPS only); it is false by default so the cookie also works over plain http on
# localhost. COOKIE_SAMESITE can stay "lax" as long as the frontend reaches the API
# same-site (in production a Vercel rewrite proxies /api/* to this backend).
COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Comma-separated browser origins allowed to call the API with credentials.
# Only needed for local dev (:3000 -> :8000) - the production proxy is same-origin.
# Wildcards are not permitted when credentials are included.
CORS_ORIGINS=http://localhost:3000
