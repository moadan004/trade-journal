# Postgres connection string (psycopg v3 driver).
# For local dev with the provided docker-compose.yml, this matches out of the box.
DATABASE_URL=postgresql+psycopg://trade_journal:trade_journal@localhost:5432/trade_journal

# Secret used to sign JWTs. Generate a strong random value for real use, e.g.:
#   openssl rand -hex 32
JWT_SECRET=change-me

# Google OAuth Client ID (from Google Cloud Console -> APIs & Services -> Credentials).
# Used as the expected "audience" when verifying Google ID tokens on POST /auth/google.
# See the "Google OAuth setup" section in README.md for how to create one.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
