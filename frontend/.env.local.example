# Origin of the FastAPI backend. Consumed only by the rewrite in next.config.ts,
# which proxies /api/* to it. Deliberately NOT prefixed with NEXT_PUBLIC_ so the
# backend URL is never shipped in the client bundle - the browser only ever calls
# the frontend's own origin, which is what keeps the auth cookie same-site.
BACKEND_ORIGIN=http://localhost:8000

# Google OAuth Client ID (same value as the backend's GOOGLE_CLIENT_ID).
# Until this is a real Client ID, the "Sign in with Google" button on /login and
# /register shows a "not configured" note instead of trying to load Google's SDK.
# See the "Google OAuth setup" section in README.md for how to create one.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
